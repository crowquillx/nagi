{
  lib,
  pkgs,
  config,
  vars ? { },
  inputs,
  ...
}:
let
  v = vars;
  get = path: default: lib.attrByPath path default v;
  desktopEnabled = get [ "desktop" "enable" ] true;
  shell = import ./session-shell/lib.nix { inherit lib vars; };
  inherit (shell) noctaliaEnable hasWaylandCompositor;
  noctaliaSettings = get [ "desktop" "noctalia" "settings" ] { };
  noctaliaAssets = "${inputs.noctalia}/assets/templates";
  # Noctalia's GTK templates import noctalia-extensions.css, but only its
  # built-in gtk3/gtk4 templates create that index. Seed the empty index it
  # would write so the user-template import resolves; Noctalia may replace it.
  gtkExtensionIndex = pkgs.writeText "noctalia-extensions.css" ''
    /* Generated by Noctalia: GTK extensions of enabled community templates. Do not edit. */
  '';
  seedGtkExtensionIndex =
    dir:
    let
      index = "${config.xdg.configHome}/${dir}/noctalia-extensions.css";
    in
    ''
      if [ ! -e ${lib.escapeShellArg index} ]; then
        run install -D -m 644 ${gtkExtensionIndex} ${lib.escapeShellArg index}
      fi
    '';

  # These templates only write separate generated files. The main application
  # configs remain owned by Home Manager and include or select those files.
  userTemplates = {
    gtk3 = {
      input_path = "${noctaliaAssets}/gtk/gtk3.css";
      output_path = "$XDG_CONFIG_HOME/gtk-3.0/noctalia.css";
    };
    gtk4 = {
      input_path = "${noctaliaAssets}/gtk/gtk4.css";
      output_path = "$XDG_CONFIG_HOME/gtk-4.0/noctalia.css";
    };
    qt = {
      input_path = "${noctaliaAssets}/qt/qtct.conf";
      output_path = [
        "$XDG_CONFIG_HOME/qt5ct/colors/noctalia.conf"
        "$XDG_CONFIG_HOME/qt6ct/colors/noctalia.conf"
      ];
    };
    ghostty = {
      input_path = "${noctaliaAssets}/ghostty/ghostty";
      output_path = "$XDG_CONFIG_HOME/ghostty/themes/Rose Pine";
    };
    kitty = {
      input_path = "${noctaliaAssets}/kitty/kitty.conf";
      output_path = "$XDG_CONFIG_HOME/kitty/themes/noctalia.conf";
    };
  };

  requiredSettings = {
    shell.polkit_agent = true;
    theme.templates = {
      enable_builtin_templates = true;
      builtin_ids = [
        "kcolorscheme"
        "umbriel"
      ];
      user = userTemplates;
    };
  };
in
{
  config = lib.mkIf (desktopEnabled && hasWaylandCompositor && noctaliaEnable) {
    programs.noctalia = {
      enable = true;
      # Track the flake input so the shell stays IPC-compatible with the
      # pinned Umbriel; the nixpkgs release can lag compositor protocol changes.
      package = inputs.noctalia.packages.${pkgs.stdenv.hostPlatform.system}.default;
      systemd.enable = false;
      settings = lib.recursiveUpdate noctaliaSettings requiredSettings;
    };

    home.activation.seedNoctaliaGtkExtensionIndex = lib.hm.dag.entryAfter [ "linkGeneration" ] (
      lib.concatMapStrings seedGtkExtensionIndex [
        "gtk-3.0"
        "gtk-4.0"
      ]
    );
  };
}
