#!/usr/bin/env bash
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
sync_bin="${NAGI_REPO_SYNC_BIN:-$script_dir/nagi-repo-sync}"

# On codebox the mirrors live next door, so no ssh is needed. The generic
# script handles enrollment, cloning, origin propagation, and checkpoints.
export NAGI_REPO_SYNC_ROOT="${NAGI_REPO_SYNC_ROOT:-$HOME/Development/projects}"
export NAGI_REPO_SYNC_MIRROR_PATH="${NAGI_REPO_SYNC_MIRROR_PATH:-$HOME/git-mirrors}"
export NAGI_REPO_SYNC_REMOTE_NAME="${NAGI_REPO_SYNC_REMOTE_NAME:-codebox}"
unset NAGI_REPO_SYNC_REMOTE_HOST

exec bash "$sync_bin"
