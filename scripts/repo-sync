#!/usr/bin/env bash
set -uo pipefail

root="${NAGI_REPO_SYNC_ROOT:-$HOME/REPOS}"
remote_name="${NAGI_REPO_SYNC_REMOTE_NAME:-codebox}"
if [[ "$remote_name" == "origin" ]]; then
  printf 'repo-sync: refusing "origin" as the sync remote; hosted remotes must stay default\n' >&2
  exit 2
fi
remote_host="${NAGI_REPO_SYNC_REMOTE_HOST:-}"
mirror_dir="${NAGI_REPO_SYNC_MIRROR_DIR:-git-mirrors}"
mirror_path_local="${NAGI_REPO_SYNC_MIRROR_PATH:-}"
explicit_repositories="${NAGI_REPO_SYNC_REPOSITORIES:-}"
checkpoint_repositories="${NAGI_REPO_SYNC_CHECKPOINT_REPOSITORIES:-}"
sync_host="${NAGI_REPO_SYNC_HOST:-$(hostname -s)}"
state_dir="${NAGI_REPO_SYNC_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nagi-repo-sync}"
export GIT_SSH_COMMAND="${NAGI_REPO_SYNC_SSH_COMMAND:-ssh -o BatchMode=yes}"
failures=0
mode="sync"

if [[ "${1-}" == "--checkpoint-only" ]]; then
  mode="checkpoint"
  shift
fi
if [[ $# -ne 0 ]]; then
  printf 'repo-sync: usage: nagi-repo-sync [--checkpoint-only]\n' >&2
  exit 2
fi

log() {
  printf 'repo-sync: %s\n' "$*"
}

warn() {
  printf 'repo-sync: warning: %s\n' "$*" >&2
}

has_mirror_access() {
  [[ -n "$mirror_path_local" || -n "$remote_host" ]]
}

mirror_url_for() {
  if [[ -n "$mirror_path_local" ]]; then
    printf '%s/%s.git\n' "$mirror_path_local" "$1"
  else
    printf '%s:%s/%s.git\n' "$remote_host" "$mirror_dir" "$1"
  fi
}

run_in_mirror_context() {
  local name="$1"
  shift
  if [[ -n "$mirror_path_local" ]]; then
    git --git-dir="$mirror_path_local/$name.git" "$@"
  else
    ssh -o BatchMode=yes "$remote_host" git --git-dir="$mirror_dir/$name.git" "$@"
  fi
}

list_mirrors() {
  if [[ -n "$mirror_path_local" ]]; then
    local m name recorded deleted
    for m in "$mirror_path_local"/*.git; do
      [[ -d "$m" ]] || continue
      name="$(basename -- "$m")"
      name="${name%.git}"
      recorded="$(git --git-dir="$m" config --get nagi.origin-url || true)"
      deleted="$(git --git-dir="$m" config --get nagi.deleted || true)"
      printf '%s\t%s\t%s\n' "$name" "$recorded" "$deleted"
    done
  elif [[ -n "$remote_host" ]]; then
    ssh -o BatchMode=yes "$remote_host" "for m in \"$mirror_dir\"/*.git; do [ -d \"\$m\" ] || continue; printf '%s\t%s\t%s\n' \"\$(basename \"\$m\" .git)\" \"\$(git --git-dir=\"\$m\" config --get nagi.origin-url 2>/dev/null || true)\" \"\$(git --git-dir=\"\$m\" config --get nagi.deleted 2>/dev/null || true)\"; done"
  fi
}

record_origin() {
  run_in_mirror_context "$1" config nagi.origin-url "$2"
}

record_deletion() {
  run_in_mirror_context "$1" config nagi.deleted "${2-}"
}

seen_marker() {
  printf '%s/repos/%s\n' "$state_dir" "$1"
}

# Remember that this host has a checkout of the mirror, so a later local
# deletion of the directory can be recognized as intentional.
mark_seen() {
  local repo="$1"
  local mirror_name
  local marker

  has_mirror_access || return 0
  [[ -z "${explicit_paths[$repo]+x}" ]] || return 0
  mirror_name="$(resolve_mirror_name "$repo" "${repo##*/}")"
  valid_component "$mirror_name" || return 0
  marker="$(seen_marker "$mirror_name")" || return 0
  mkdir -p -- "${marker%/*}" 2>/dev/null || return 0
  : >"$marker" 2>/dev/null || true
}

normalize_git_url() {
  local url="$1"
  url="${url%/}"
  url="${url%.git}"
  printf '%s\n' "$url"
}

# If some remote already points at the recorded hosted URL, reuse it as
# origin instead of creating a duplicate. Returns 0 if a rename was done.
reuse_hosted_remote_as_origin() {
  local repo="$1"
  local recorded="$2"
  local r rurl
  local norm_recorded
  norm_recorded="$(normalize_git_url "$recorded")"
  for r in $(git -C "$repo" remote 2>/dev/null || true); do
    [[ "$r" == "$remote_name" ]] && continue
    [[ "$r" == "origin" ]] && continue
    rurl="$(git -C "$repo" remote get-url "$r" 2>/dev/null || true)"
    [[ -n "$rurl" ]] || continue
    if [[ "$(normalize_git_url "$rurl")" == "$norm_recorded" ]]; then
      git -C "$repo" remote rename "$r" origin 2>/dev/null && return 0
    fi
  done
  return 1
}

valid_component() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_relative_path() {
  [[ "$1" =~ ^[A-Za-z0-9._/-]+$ ]] && [[ "$1" != /* ]] && [[ "$1" != *..* ]]
}

operation_in_progress() {
  local repo="$1"
  local marker

  for marker in index.lock MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    marker="$(git -C "$repo" rev-parse --git-path "$marker")"
    if [[ -e "$repo/$marker" || -e "$marker" ]]; then
      return 0
    fi
  done
  return 1
}

ensure_remote() {
  local repo="$1"
  local name="$2"
  local branch="$3"
  local mirror_path
  local url

  if git -C "$repo" remote get-url "$remote_name" >/dev/null 2>&1; then
    return 0
  fi

  if ! valid_component "$name" || ! valid_relative_path "$branch" || ! valid_relative_path "$mirror_dir"; then
    warn "$name cannot be enrolled because its name, branch, or mirror path is unsafe"
    return 1
  fi

  url="$(mirror_url_for "$name")"
  if [[ -n "$mirror_path_local" ]]; then
    if ! mkdir -p -- "$mirror_path_local"; then
      warn "could not create $mirror_path_local"
      return 1
    fi
    if [[ ! -d "$url" ]]; then
      log "creating $url"
      if ! git init --bare "$url" >/dev/null; then
        warn "could not initialize $url"
        return 1
      fi
    fi
  else
    if [[ -z "$remote_host" ]]; then
      warn "$name has no '$remote_name' remote"
      return 1
    fi
    mirror_path="$mirror_dir/$name.git"
    log "creating $url"
    if ! ssh -o BatchMode=yes "$remote_host" mkdir -p "$mirror_dir"; then
      warn "could not create $remote_host:$mirror_dir"
      return 1
    fi
    if ! ssh -o BatchMode=yes "$remote_host" git init --bare "$mirror_path" >/dev/null; then
      warn "could not initialize $remote_host:$mirror_path"
      return 1
    fi
  fi
  if ! git -C "$repo" remote add "$remote_name" "$url"; then
    warn "could not add the '$remote_name' remote to $name"
    return 1
  fi
  if ! git -C "$repo" push "$remote_name" --all; then
    warn "initial branch push failed for $name"
    return 1
  fi
  if ! git -C "$repo" push "$remote_name" --tags; then
    warn "initial tag push failed for $name"
    return 1
  fi
  if ! run_in_mirror_context "$name" symbolic-ref HEAD "refs/heads/$branch"; then
    warn "could not set the default branch for $name"
    return 1
  fi

  local hosted_url
  hosted_url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$hosted_url" || "$hosted_url" == "$url" ]]; then
    local r rurl
    for r in $(git -C "$repo" remote 2>/dev/null || true); do
      [[ "$r" == "$remote_name" ]] && continue
      rurl="$(git -C "$repo" remote get-url "$r" 2>/dev/null || true)"
      [[ -n "$rurl" && "$rurl" != "$url" ]] || continue
      hosted_url="$rurl"
      break
    done
  fi
  if [[ -n "$hosted_url" && "$hosted_url" != "$url" ]]; then
    record_origin "$name" "$hosted_url" >/dev/null \
      || warn "could not record the origin URL for $name"
  fi
}

worktree_tree() {
  local repo="$1"
  local temporary_index
  local tree

  temporary_index="$(mktemp "${TMPDIR:-/tmp}/nagi-repo-sync-index.XXXXXX")" || return 1
  rm -f -- "$temporary_index"

  if ! GIT_INDEX_FILE="$temporary_index" git -C "$repo" read-tree HEAD; then
    rm -f -- "$temporary_index"
    return 1
  fi
  if ! GIT_INDEX_FILE="$temporary_index" git -C "$repo" add -A -- .; then
    rm -f -- "$temporary_index"
    return 1
  fi
  if ! tree="$(GIT_INDEX_FILE="$temporary_index" git -C "$repo" write-tree)"; then
    rm -f -- "$temporary_index"
    return 1
  fi

  rm -f -- "$temporary_index"
  printf '%s\n' "$tree"
}

checkpoint_base() {
  git -C "$1" show -s --format=%B "$2" \
    | sed -n 's/^Nagi-Base: //p' \
    | head -n 1
}

checkpoint_preflight() {
  local repo="$1"
  local name="$2"
  local base="$3"
  local tree="$4"
  local path
  local private_key_pattern
  local -a changed_paths=()
  local -a suspicious_paths=()

  private_key_pattern='^\+.*(-----BEGIN ([A-Z0-9 ]+ )?PRIVATE'
  private_key_pattern+=' KEY-----|AGE-SECRET-'
  private_key_pattern+='KEY-)'

  while IFS= read -r -d '' path; do
    changed_paths+=( "$path" )
  done < <(git -C "$repo" diff --name-only -z "$base" "$tree" -- .)

  for path in "${changed_paths[@]}"; do
    if git -C "$repo" diff --no-ext-diff --unified=0 --text "$base" "$tree" -- "$path" \
      | grep -E -e "$private_key_pattern" >/dev/null; then
      suspicious_paths+=( "$path" )
    fi
  done

  if (( ${#suspicious_paths[@]} > 0 )); then
    warn "$name checkpoint contains private-key material; refusing to store it"
    printf 'repo-sync: warning:   %s\n' "${suspicious_paths[@]}" >&2
    return 1
  fi

  for path in "${changed_paths[@]}"; do
    case "$path" in
      secrets/*.yaml|secrets/*.yml)
        if ! git -C "$repo" cat-file -e "$tree:$path" 2>/dev/null; then
          continue
        fi
        if ! git -C "$repo" grep -q -e '^sops:' "$tree" -- "$path" \
          || ! git -C "$repo" grep -Fq -e 'ENC[' "$tree" -- "$path"; then
          warn "$name checkpoint contains an unencrypted SOPS YAML file: $path"
          return 1
        fi
        ;;
    esac
  done

  return 0
}

fetch_checkpoints() {
  local repo="$1"
  local refspec="+refs/nagi/checkpoints/*:refs/nagi/remotes/${remote_name}/*"

  if ! git -C "$repo" fetch --prune "$remote_name" "$refspec"; then
    warn "checkpoint fetch failed for ${repo##*/}"
    return 1
  fi
}

applied_state_file() {
  local git_dir
  git_dir="$(git -C "$1" rev-parse --absolute-git-dir)" || return 1
  printf '%s/nagi-repo-sync/last-applied\n' "$git_dir"
}

clear_applied_state() {
  local state_file
  state_file="$(applied_state_file "$1")" || return 0
  rm -f -- "$state_file"
}

create_checkpoint() {
  local repo="$1"
  local name="${repo##*/}"
  local branch
  local head
  local tree
  local own_ref
  local remote_own_ref
  local local_oid
  local remote_oid
  local previous_oid
  local previous_tree
  local previous_base
  local state_file
  local applied_oid=""
  local author_name
  local author_email
  local commit_oid
  local expected_old
  local parent_args=()

  if operation_in_progress "$repo"; then
    warn "$name has a Git operation in progress; checkpoint deferred"
    return 0
  fi
  if [[ -z "$(git -C "$repo" status --porcelain --untracked-files=normal)" ]]; then
    return 0
  fi
  if ! branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)"; then
    warn "$name has a detached HEAD; checkpoint deferred"
    return 0
  fi
  if ! ensure_remote "$repo" "$name" "$branch"; then
    return 1
  fi
  if ! fetch_checkpoints "$repo"; then
    return 1
  fi

  head="$(git -C "$repo" rev-parse HEAD)" || return 1
  tree="$(worktree_tree "$repo")" || {
    warn "could not snapshot $name"
    return 1
  }
  if ! checkpoint_preflight "$repo" "$name" "$head" "$tree"; then
    return 1
  fi
  state_file="$(applied_state_file "$repo")" || return 1
  if [[ -f "$state_file" ]]; then
    applied_oid="$(<"$state_file")"
  fi
  if [[ -n "$applied_oid" ]] \
    && git -C "$repo" cat-file -e "${applied_oid}^{commit}" 2>/dev/null \
    && [[ "$(git -C "$repo" rev-parse "${applied_oid}^{tree}")" == "$tree" ]] \
    && [[ "$(checkpoint_base "$repo" "$applied_oid")" == "$head" ]]; then
    return 0
  fi

  own_ref="refs/nagi/checkpoints/$sync_host"
  remote_own_ref="refs/nagi/remotes/$remote_name/$sync_host"
  local_oid="$(git -C "$repo" rev-parse --verify "$own_ref" 2>/dev/null || true)"
  remote_oid="$(git -C "$repo" rev-parse --verify "$remote_own_ref" 2>/dev/null || true)"
  previous_oid="$local_oid"

  if [[ -z "$previous_oid" ]]; then
    previous_oid="$remote_oid"
  elif [[ -n "$remote_oid" && "$previous_oid" != "$remote_oid" ]]; then
    if git -C "$repo" merge-base --is-ancestor "$previous_oid" "$remote_oid"; then
      previous_oid="$remote_oid"
    elif ! git -C "$repo" merge-base --is-ancestor "$remote_oid" "$previous_oid"; then
      warn "$name checkpoint history for $sync_host diverged; refusing to overwrite it"
      return 1
    fi
  fi

  if [[ -n "$previous_oid" ]]; then
    previous_tree="$(git -C "$repo" rev-parse "${previous_oid}^{tree}")"
    previous_base="$(checkpoint_base "$repo" "$previous_oid")"
    if [[ "$previous_tree" == "$tree" && "$previous_base" == "$head" ]]; then
      if [[ "$local_oid" != "$previous_oid" ]]; then
        git -C "$repo" update-ref "$own_ref" "$previous_oid" "$local_oid" || return 1
      fi
      if [[ "$remote_oid" != "$previous_oid" ]]; then
        git -C "$repo" push "$remote_name" "$own_ref:$own_ref" || return 1
      fi
      return 0
    fi
    parent_args=( -p "$previous_oid" )
  else
    parent_args=( -p "$head" )
  fi

  author_name="$(git -C "$repo" config user.name || true)"
  author_email="$(git -C "$repo" config user.email || true)"
  author_name="${author_name:-nagi repo-sync}"
  author_email="${author_email:-repo-sync@localhost}"
  commit_oid="$(
    GIT_AUTHOR_NAME="$author_name" \
      GIT_AUTHOR_EMAIL="$author_email" \
      GIT_COMMITTER_NAME="$author_name" \
      GIT_COMMITTER_EMAIL="$author_email" \
      git -C "$repo" commit-tree "$tree" "${parent_args[@]}" \
        -m "chore(sync): checkpoint $sync_host" \
        -m "Nagi-Base: $head"$'\n'"Nagi-Host: $sync_host"
  )" || {
    warn "could not create checkpoint commit for $name"
    return 1
  }

  expected_old="${local_oid:-0000000000000000000000000000000000000000}"
  if ! git -C "$repo" update-ref -m "repo-sync checkpoint" "$own_ref" "$commit_oid" "$expected_old"; then
    warn "could not update the local checkpoint ref for $name"
    return 1
  fi
  if ! git -C "$repo" push "$remote_name" "$own_ref:$own_ref"; then
    warn "could not publish the checkpoint for $name"
    return 1
  fi

  clear_applied_state "$repo"
  log "checkpointed $name from $sync_host"
}

restore_checkpoint() {
  local repo="$1"
  local name="${repo##*/}"
  local head
  local ref
  local source_host
  local candidate_oid=""
  local candidate_ref=""
  local candidate_tree
  local head_tree
  local state_file
  local applied_oid=""

  if operation_in_progress "$repo"; then
    return 0
  fi
  if [[ -n "$(git -C "$repo" status --porcelain --untracked-files=normal)" ]]; then
    return 0
  fi
  if ! fetch_checkpoints "$repo"; then
    return 1
  fi

  head="$(git -C "$repo" rev-parse HEAD)" || return 1
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    source_host="${ref##*/}"
    [[ "$source_host" != "$sync_host" ]] || continue
    if [[ "$(checkpoint_base "$repo" "$ref")" == "$head" ]]; then
      candidate_ref="$ref"
      candidate_oid="$(git -C "$repo" rev-parse "$ref")"
      break
    fi
  done < <(
    git -C "$repo" for-each-ref \
      --sort=-committerdate \
      --format='%(refname)' \
      "refs/nagi/remotes/$remote_name/"
  )

  [[ -n "$candidate_oid" ]] || return 0
  state_file="$(applied_state_file "$repo")" || return 1
  if [[ -f "$state_file" ]]; then
    applied_oid="$(<"$state_file")"
  fi
  [[ "$applied_oid" != "$candidate_oid" ]] || return 0

  candidate_tree="$(git -C "$repo" rev-parse "${candidate_oid}^{tree}")"
  head_tree="$(git -C "$repo" rev-parse "${head}^{tree}")"
  if [[ "$candidate_tree" != "$head_tree" ]]; then
    if ! git -C "$repo" diff --binary "$head" "$candidate_ref" -- . \
      | git -C "$repo" apply --check --whitespace=nowarn -; then
      warn "$name checkpoint from ${candidate_ref##*/} no longer applies cleanly"
      return 1
    fi
    if ! git -C "$repo" diff --binary "$head" "$candidate_ref" -- . \
      | git -C "$repo" apply --whitespace=nowarn -; then
      warn "$name checkpoint restore failed"
      return 1
    fi
  fi

  mkdir -p -- "${state_file%/*}"
  printf '%s\n' "$candidate_oid" >"$state_file"
  log "restored uncommitted $name checkpoint from ${candidate_ref##*/}"
}

origin_state_file() {
  local git_dir
  git_dir="$(git -C "$1" rev-parse --absolute-git-dir)" || return 1
  printf '%s/nagi-repo-sync/origin\n' "$git_dir"
}

# Keep the hosted origin consistent across hosts. Each checkout remembers the
# origin URL it last saw or published; a local change is published to the
# mirror, a peer change is adopted, and simultaneous changes need manual care.
propagate_origin() {
  local repo="$1"
  local name="$2"
  local recorded="$3"
  local current
  local announced
  local state_file
  local branch

  state_file="$(origin_state_file "$repo")" || return 1
  current="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"

  if [[ ! -f "$state_file" ]]; then
    mkdir -p -- "${state_file%/*}" || return 1
    if [[ -z "$current" && -n "$recorded" ]]; then
      # A peer published an origin (or this is a legacy mirror-as-origin
      # checkout); adopt it right away instead of waiting a cycle.
      if reuse_hosted_remote_as_origin "$repo" "$recorded" || git -C "$repo" remote add origin "$recorded"; then
        if branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)"; then
          git -C "$repo" fetch --quiet origin || true
          git -C "$repo" config "branch.${branch}.remote" origin || true
          git -C "$repo" config "branch.${branch}.merge" "refs/heads/${branch}" || true
        fi
        printf '%s\n' "$recorded" >"$state_file"
        log "adopted origin for $name from $remote_name"
        return 0
      fi
      warn "could not add the origin of $name"
      return 1
    fi
    printf '%s\n' "$current" >"$state_file"
    return 0
  fi
  announced="$(<"$state_file")"

  if [[ "$current" == "$announced" ]]; then
    if [[ -n "$recorded" && "$recorded" != "$announced" ]]; then
      if [[ -n "$current" ]]; then
        if ! git -C "$repo" remote set-url origin "$recorded"; then
          warn "could not update the origin of $name"
          return 1
        fi
      else
        if ! reuse_hosted_remote_as_origin "$repo" "$recorded" && ! git -C "$repo" remote add origin "$recorded"; then
          warn "could not add the origin of $name"
          return 1
        fi
        if branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)"; then
          git -C "$repo" fetch --quiet origin || true
          git -C "$repo" config "branch.${branch}.remote" origin || true
          git -C "$repo" config "branch.${branch}.merge" "refs/heads/${branch}" || true
        fi
      fi
      printf '%s\n' "$recorded" >"$state_file"
      log "adopted origin for $name from $remote_name"
    elif [[ -z "$recorded" && -n "$announced" ]]; then
      record_origin "$name" "$announced" >/dev/null \
        || { warn "could not publish the origin of $name"; return 1; }
      log "published origin for $name"
    fi
    return 0
  fi

  if [[ -z "$current" ]]; then
    warn "$name has no origin locally; keeping the recorded origin"
    return 0
  fi
  if [[ -n "$recorded" && "$recorded" != "$announced" ]]; then
    if [[ "$current" == "$recorded" ]]; then
      printf '%s\n' "$current" >"$state_file"
      log "adopted origin for $name from $remote_name (converged)"
      return 0
    fi
    warn "$name origin changed on multiple hosts ($current vs $recorded); resolve it manually"
    return 0
  fi

  record_origin "$name" "$current" >/dev/null \
    || { warn "could not publish the origin of $name"; return 1; }
  printf '%s\n' "$current" >"$state_file"
  log "published origin for $name"
}

normalize_remotes() {
  local repo="$1"
  local name="$2"
  local own_url
  local origin_url

  # Legacy checkouts used the mirror itself as their push default.
  own_url="$(mirror_url_for "$name")"
  origin_url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [[ "$origin_url" == "$own_url" ]]; then
    if git -C "$repo" remote get-url "$remote_name" >/dev/null 2>&1; then
      git -C "$repo" remote remove origin
    else
      git -C "$repo" remote rename origin "$remote_name"
    fi
  fi
}

sync_repo() {
  local repo="$1"
  local name="${repo##*/}"
  local mirror_name
  local branch
  local local_ref
  local remote_ref
  local local_oid
  local remote_oid
  local dirty
  local current_tree
  local remote_tree

  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi
  if operation_in_progress "$repo"; then
    warn "$name has a Git operation in progress; skipping"
    return 0
  fi
  if ! git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1; then
    warn "$name has no commits yet; commit it before synchronization"
    return 0
  fi
  if ! branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)"; then
    branch="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    branch="${branch#origin/}"
    if [[ -z "$branch" ]]; then
      warn "$name has a detached HEAD and no known default branch; skipping"
      return 0
    fi
    if ! ensure_remote "$repo" "$name" "$branch"; then
      return 1
    fi
    warn "$name is mirrored, but its detached HEAD will not be advanced automatically"
    return 0
  fi
  if ! ensure_remote "$repo" "$name" "$branch"; then
    return 1
  fi
  normalize_remotes "$repo" "$name"
  mirror_name="$(resolve_mirror_name "$repo" "$name")"
  propagate_origin "$repo" "$mirror_name" "${mirror_origins[$mirror_name]-}" || return 1
  # Hosted remotes must stay the push default: if the current branch still
  # tracks the sync remote, point it at origin instead (when origin exists).
  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    branch_remote="$(git -C "$repo" config --get "branch.${branch}.remote" 2>/dev/null || true)"
    branch_merge="$(git -C "$repo" config --get "branch.${branch}.merge" 2>/dev/null || true)"
    if [[ "$branch_remote" == "$remote_name" || -z "$branch_merge" ]]; then
      git -C "$repo" config "branch.${branch}.remote" origin || true
      git -C "$repo" config "branch.${branch}.merge" "refs/heads/${branch}" || true
    fi
  fi

  if ! git -C "$repo" fetch --prune "$remote_name"; then
    warn "fetch failed for $name"
    return 1
  fi

  local_ref="refs/heads/$branch"
  remote_ref="refs/remotes/$remote_name/$branch"
  if ! git -C "$repo" show-ref --verify --quiet "$remote_ref"; then
    log "publishing $name:$branch"
    git -C "$repo" push "$remote_name" "$local_ref:refs/heads/$branch"
    return
  fi

  local_oid="$(git -C "$repo" rev-parse "$local_ref")"
  remote_oid="$(git -C "$repo" rev-parse "$remote_ref")"
  if [[ "$local_oid" == "$remote_oid" ]]; then
    return 0
  fi

  if git -C "$repo" merge-base --is-ancestor "$remote_ref" "$local_ref"; then
    log "pushing $name:$branch"
    if ! git -C "$repo" push "$remote_name" "$local_ref:refs/heads/$branch"; then
      warn "push failed for $name:$branch; another host may have updated it"
      return 1
    fi
    return 0
  fi

  if git -C "$repo" merge-base --is-ancestor "$local_ref" "$remote_ref"; then
    dirty="$(git -C "$repo" status --porcelain --untracked-files=normal)"
    if [[ -n "$dirty" ]]; then
      current_tree="$(worktree_tree "$repo" || true)"
      remote_tree="$(git -C "$repo" rev-parse "${remote_ref}^{tree}")"
      if [[ -n "$current_tree" && "$current_tree" == "$remote_tree" ]]; then
        log "advancing $name:$branch to an identical committed checkpoint"
        if ! git -C "$repo" reset --mixed "$remote_ref" >/dev/null; then
          warn "could not advance $name:$branch"
          return 1
        fi
        clear_applied_state "$repo"
        return 0
      fi
      warn "$name:$branch is behind $remote_name but has uncommitted changes; fast-forward deferred"
      return 0
    fi
    log "fast-forwarding $name:$branch"
    if ! git -C "$repo" merge --ff-only "$remote_ref"; then
      warn "fast-forward failed for $name:$branch"
      return 1
    fi
    clear_applied_state "$repo"
    return 0
  fi

  warn "$name:$branch diverged from $remote_name/$branch; resolve it manually"
  return 1
}

# Mirror checkouts that exist on a peer but not here are cloned into the
# repository root, with the hosted remote restored as the push default.
clone_missing_mirrors() {
  local name
  local target
  local hosted_url
  local branch
  local state_file
  local canonical
  local cloned=0

  if [[ ! -d "$root" ]]; then
    mkdir -p -- "$root" || { warn "could not create $root"; return 1; }
  fi
  for name in "${!mirror_origins[@]}"; do
    if ! valid_component "$name"; then
      warn "refusing unsafe mirror name: $name"
      continue
    fi
    if [[ -n "${mirror_deleted[$name]-}" ]]; then
      continue
    fi
    target="$root/$name"
    [[ -e "$target" ]] && continue
    if repository_tracks_mirror "$name"; then
      continue
    fi
    log "cloning $name from $remote_name"
    if ! git clone --quiet --origin "$remote_name" "$(mirror_url_for "$name")" "$target"; then
      warn "clone failed for $name"
      failures=$((failures + 1))
      continue
    fi
    cloned=$((cloned + 1))

    hosted_url="${mirror_origins[$name]}"
    if [[ -n "$hosted_url" ]]; then
      if git -C "$target" remote add origin "$hosted_url"; then
        if branch="$(git -C "$target" symbolic-ref --quiet --short HEAD)"; then
          git -C "$target" fetch --quiet origin || true
          git -C "$target" config "branch.${branch}.remote" origin || true
          git -C "$target" config "branch.${branch}.merge" "refs/heads/${branch}" || true
        fi
        state_file="$(origin_state_file "$target")" || true
        if [[ -n "$state_file" ]]; then
          mkdir -p -- "${state_file%/*}" || true
          printf '%s\n' "$hosted_url" >"$state_file"
        fi
      else
        warn "could not add the hosted origin for $name"
      fi
    else
      warn "$name has no recorded origin yet; add one anywhere and it will propagate"
    fi

    if canonical="$(readlink -f -- "$target")"; then
      repositories+=( "$canonical" )
      seen_repositories["$canonical"]=1
    fi
  done
  (( cloned > 0 )) && log "cloned $cloned missing checkout(s)"
  return 0
}

# A checkout that this host has synced before but whose directory is now gone
# was deleted on purpose; publish that intent to the mirror as a tombstone.
publish_deletions() {
  local name
  local marker

  for name in "${!mirror_origins[@]}"; do
    valid_component "$name" || continue
    [[ -z "${mirror_deleted[$name]-}" ]] || continue
    if [[ -e "$root/$name" ]]; then
      continue
    fi
    if repository_tracks_mirror "$name"; then
      continue
    fi
    marker="$(seen_marker "$name")"
    [[ -f "$marker" ]] || continue
    if ! record_deletion "$name" "$sync_host" >/dev/null; then
      warn "could not publish the deletion of $name"
      failures=$((failures + 1))
      continue
    fi
    mirror_deleted["$name"]="$sync_host"
    rm -f -- "$marker"
    log "published deletion of $name from $sync_host"
  done
}

# Remove local checkouts of mirrors that a peer has deleted. Only clean,
# fully pushed, non-explicit checkouts are removed; anything else is left
# in place with a warning.
apply_deletions() {
  local repo
  local name
  local branch
  local local_ref
  local remote_ref
  declare -a keep=()

  for repo in "${repositories[@]}"; do
    name="$(resolve_mirror_name "$repo" "${repo##*/}")"
    if [[ -z "${mirror_deleted[$name]-}" ]]; then
      keep+=( "$repo" )
      continue
    fi
    if [[ -n "${explicit_paths[$repo]+x}" ]]; then
      warn "$name was deleted on ${mirror_deleted[$name]}, but it is an explicitly configured repository; remove it from the sync configuration first"
      keep+=( "$repo" )
      continue
    fi
    case "$repo" in
      "$root"/*) ;;
      *)
        keep+=( "$repo" )
        continue
        ;;
    esac
    if operation_in_progress "$repo"; then
      warn "$name has a Git operation in progress; deletion deferred"
      failures=$((failures + 1))
      continue
    fi
    if [[ -n "$(git -C "$repo" status --porcelain --untracked-files=normal)" ]]; then
      warn "$name has uncommitted changes; deletion deferred"
      failures=$((failures + 1))
      continue
    fi
    if ! git -C "$repo" fetch --quiet "$remote_name" 2>/dev/null; then
      warn "$name could not reach $remote_name; deletion deferred"
      failures=$((failures + 1))
      continue
    fi
    branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD || true)"
    if [[ -n "$branch" ]]; then
      local_ref="refs/heads/$branch"
      remote_ref="refs/remotes/$remote_name/$branch"
      if git -C "$repo" show-ref --verify --quiet "$remote_ref" \
        && ! git -C "$repo" merge-base --is-ancestor "$local_ref" "$remote_ref"; then
        warn "$name has commits not present on $remote_name; deletion deferred"
        failures=$((failures + 1))
        continue
      fi
    fi
    rm -rf -- "$repo"
    rm -f -- "$(seen_marker "$name")"
    log "removed $name (deleted on ${mirror_deleted[$name]})"
  done
  repositories=( "${keep[@]}" )
}

declare -a repositories=()
declare -A seen_repositories=()
declare -A checkpoint_paths=()
declare -A mirror_origins=()
declare -A mirror_by_url=()
declare -A mirror_deleted=()
declare -A explicit_paths=()

# Resolve the mirror a repository belongs to by its sync remote URL, so
# checkouts whose directory name differs from the mirror name are still
# matched. Falls back to the directory name.
resolve_mirror_name() {
  local repo="$1"
  local fallback="$2"
  local url
  local norm

  if [[ ${#mirror_by_url[@]} -eq 0 ]]; then
    printf '%s\n' "$fallback"
    return 0
  fi
  url="$(git -C "$repo" remote get-url "$remote_name" 2>/dev/null || true)"
  [[ -n "$url" ]] || { printf '%s\n' "$fallback"; return 0; }
  norm="$(normalize_git_url "$url")"
  local candidate
  for candidate in "${!mirror_by_url[@]}"; do
    if [[ "$candidate" == "$norm" ]]; then
      printf '%s\n' "${mirror_by_url[$candidate]}"
      return 0
    fi
  done
  printf '%s\n' "$fallback"
}

# True when an existing checkout already tracks this mirror under another name.
repository_tracks_mirror() {
  local mirror_name="$1"
  local target_norm
  local repo
  local url

  target_norm="$(normalize_git_url "$(mirror_url_for "$mirror_name")")"
  for repo in "${repositories[@]}"; do
    url="$(git -C "$repo" remote get-url "$remote_name" 2>/dev/null || true)"
    [[ -n "$url" ]] || continue
    if [[ "$(normalize_git_url "$url")" == "$target_norm" ]]; then
      return 0
    fi
  done
  return 1
}

add_repository() {
  local path="$1"
  local canonical

  [[ -n "$path" ]] || return 0
  if ! canonical="$(readlink -f -- "$path" 2>/dev/null)"; then
    warn "repository path does not exist: $path"
    return 0
  fi
  if [[ -z "${seen_repositories[$canonical]+x}" ]]; then
    seen_repositories["$canonical"]=1
    repositories+=( "$canonical" )
  fi
}

mark_checkpoint_path() {
  local path="$1"
  local canonical

  [[ -n "$path" ]] || return 0
  if ! canonical="$(readlink -f -- "$path" 2>/dev/null)"; then
    warn "checkpoint path does not exist: $path"
    return 0
  fi
  checkpoint_paths["$canonical"]=1
  add_repository "$canonical"
}

IFS=':' read -r -a configured_repositories <<<"$explicit_repositories"
for repo in "${configured_repositories[@]}"; do
  add_repository "$repo"
  if canonical="$(readlink -f -- "$repo" 2>/dev/null)"; then
    explicit_paths["$canonical"]=1
  fi
done

IFS=':' read -r -a configured_checkpoints <<<"$checkpoint_repositories"
for repo in "${configured_checkpoints[@]}"; do
  mark_checkpoint_path "$repo"
done

if [[ "$mode" == "sync" ]]; then
  if [[ -d "$root" ]]; then
    for repo in "$root"/*; do
      [[ -d "$repo" ]] || continue
      add_repository "$repo"
    done
  elif [[ ${#repositories[@]} -eq 0 ]] && { [[ "${NAGI_REPO_SYNC_AUTOCLONE:-1}" != 1 ]] || ! has_mirror_access; }; then
    warn "repository root does not exist: $root"
  fi

  if has_mirror_access && valid_relative_path "$mirror_dir"; then
    while IFS=$'\t' read -r mirror_name recorded_origin deleted_host; do
      [[ -n "$mirror_name" ]] || continue
      mirror_origins["$mirror_name"]="$recorded_origin"
      mirror_by_url["$(normalize_git_url "$(mirror_url_for "$mirror_name")")"]="$mirror_name"
      mirror_deleted["$mirror_name"]="$deleted_host"
    done < <(list_mirrors)
    if [[ -d "$root" ]]; then
      publish_deletions || failures=$((failures + 1))
    fi
    if [[ "${NAGI_REPO_SYNC_AUTOCLONE:-1}" == 1 ]]; then
      clone_missing_mirrors || failures=$((failures + 1))
    fi
    apply_deletions || failures=$((failures + 1))
  fi
fi

for repo in "${repositories[@]}"; do
  if [[ "$mode" == "sync" ]]; then
    if ! sync_repo "$repo"; then
      failures=$((failures + 1))
      continue
    fi
    mark_seen "$repo"
  fi

  if [[ -n "${checkpoint_paths[$repo]+x}" ]]; then
    if [[ "$mode" == "checkpoint" || -n "$(git -C "$repo" status --porcelain --untracked-files=normal)" ]]; then
      if ! create_checkpoint "$repo"; then
        failures=$((failures + 1))
      fi
    elif ! restore_checkpoint "$repo"; then
      failures=$((failures + 1))
    fi
  fi
done

if (( failures > 0 )); then
  warn "$failures repository operation(s) need attention"
  exit 1
fi
